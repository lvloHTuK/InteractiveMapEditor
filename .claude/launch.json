  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 4000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
